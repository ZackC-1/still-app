{
  "name": "@still/ext-chromium",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "gen-css": "node ../core/scripts/gen-content-css.mjs entrypoints/content",
    "build": "node ../core/scripts/gen-content-css.mjs entrypoints/content && wxt build",
    "build:firefox": "node ../core/scripts/gen-content-css.mjs entrypoints/content && wxt build -b firefox",
    "test": "vitest run",
    "zip": "node ../core/scripts/gen-content-css.mjs entrypoints/content && wxt zip",
    "zip:firefox": "node ../core/scripts/gen-content-css.mjs entrypoints/content && wxt zip -b firefox",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@still/core": "workspace:*",
    "@still/shared-types": "workspace:*",
    "@supabase/supabase-js": "^2.117.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@wxt-dev/module-svelte": "^2.0.5",
    "svelte": "^5.57.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "wxt": "^0.21.4"
  }
}
