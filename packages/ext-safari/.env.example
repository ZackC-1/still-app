# Still — Safari WebExtension public build inputs. Copy to packages/ext-safari/.env (gitignored).
# Only this blank template is tracked; native signing and server credentials never belong here.

# Public Supabase configuration for signed rule updates and configured native modern sync.
# Blank keeps blocking local with the bundled rules; optional account use requires configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Configured modern settings/sync opt-in: exactly "true" with both Supabase values above and the
# matching native authority. Keep the Apple webview build aligned. Once shipped, the corresponding
# one-way App Group migration must remain supported by later releases. Blank preserves legacy mode.
VITE_MODERN_SETTINGS_SYNC_ENABLED=

# Developer-only local atomic settings opt-in: exactly "true" with both Supabase values blank.
# Requires the matching converted native App Group record and app-webview local build. Leave blank
# for store builds; configured modern sync uses the separate flag above.
VITE_APPLE_ATOMIC_SETTINGS=

# Public, send-only analytics project key (ADR 0004). Blank disables analytics.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
