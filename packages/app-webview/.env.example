# Supabase config for the Apple WKWebView build (publishable, client-side keys). Copy to
# packages/app-webview/.env (gitignored) with real values, or the screen builds local-only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# [APPLE STORE BUILDS ONLY] Deterministic App Review sign-in gate (plan 2026-07-15-002). Set ONLY
# when producing an Apple store archive; extension builds must never define it. Must equal the
# hosted REVIEW_SIGNIN_EMAIL secret exactly — run the §1c cross-check in
# docs/release/extension-purchase-deploy-checklist.md before archiving. Value never committed.
VITE_REVIEW_SIGNIN_EMAIL=
