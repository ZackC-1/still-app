# Supabase config for the Apple WKWebView build (publishable, client-side keys). Copy to
# packages/app-webview/.env (gitignored) with real values, or the screen builds local-only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Compiled route selection: production or shared-hosted-sandbox. Absent retains production.
# QA requires sandbox access trust and modern settings sync; invalid combinations stay local.
# This public field never enables purchases or selects a provider mode on its own.
VITE_BACKEND_ROUTE_PROFILE=

# Modern per-field settings sync (U3-W4). Exactly "true" with the Supabase values above selects the
# committed settings screen with modern sync; anything else keeps the legacy screen. One-way: once a
# release build ships with it, every later release build must keep it, and the Safari extension's
# build must match.
VITE_MODERN_SETTINGS_SYNC_ENABLED=

# Developer-only local atomic settings opt-in: exactly "true", with both Supabase values blank
# and the matching native App Group authority. Set the same flag in ext-safari's local build.
# Conversion is one-way; leave blank for store builds. Configured modern sync uses the flag above.
VITE_APPLE_ATOMIC_SETTINGS=

# Public scoped-access verification inputs only: environment and JSON key allowlist containing
# {kid, publicKeyHex, purpose, environment}. Never copy issuer signing keys into a client bundle.
# Blank keeps default production trust with no access keys; no paid-sale activation is implied.
VITE_ACCESS_ENVIRONMENT=
VITE_ACCESS_PUBLIC_KEYS=

# [APPLE STORE BUILDS ONLY] Deterministic App Review sign-in gate (plan 2026-07-15-002). Set ONLY
# when producing an Apple store archive; extension builds must never define it. Must equal the
# hosted REVIEW_SIGNIN_EMAIL secret exactly — run the §1c cross-check in
# docs/release/extension-purchase-deploy-checklist.md before archiving. Value never committed.
VITE_REVIEW_SIGNIN_EMAIL=

# Product analytics (ADR 0004). The project key is public by design (it can only send events).
# Blank → no analytics and no "Share usage data" switch.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
