{
  "version": "1.1.8",
  "services": {
    "youtube": {
      "matches": [
        "*://*.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "surfaces": [
        {
          "id": "yt-shorts-redirect",
          "label": "Shorts URL → watch page",
          "tier": "free",
          "requiredCapability": "surface.youtube.shorts",
          "action": "redirect",
          "enabledByDefault": true,
          "redirect": {
            "urlMatch": "^/shorts(?:/([\\w-]+))?/?$",
            "to": "/watch?v=$1",
            "fallbackToPlaceholder": true
          }
        },
        {
          "id": "yt-sidebar",
          "label": "Shorts in left guide + mini-guide",
          "tier": "free",
          "requiredCapability": "surface.youtube.shorts",
          "action": "hide",
          "enabledByDefault": true,
          "selectors": [
            "ytd-guide-entry-renderer:has(a[title=\"Shorts\"])",
            "ytd-mini-guide-entry-renderer:has(a[title=\"Shorts\"])",
            "a#endpoint[title=\"Shorts\"]",
            "ytm-pivot-bar-item-renderer:has(a[href=\"/shorts\"])",
            "ytm-pivot-bar-item-renderer:has(.pivot-shorts)"
          ]
        },
        {
          "id": "yt-home-shelf",
          "label": "Shorts shelf on Home",
          "tier": "free",
          "requiredCapability": "surface.youtube.shorts",
          "action": "remove",
          "enabledByDefault": true,
          "selectors": [
            "ytd-rich-section-renderer:has(ytd-rich-shelf-renderer[is-shorts])",
            "ytm-rich-section-renderer:has(ytm-shorts-lockup-view-model)",
            "ytm-rich-section-renderer:has(ytm-reel-shelf-renderer)",
            "ytd-reel-shelf-renderer",
            "ytm-reel-shelf-renderer",
            "grid-shelf-view-model:has(ytm-shorts-lockup-view-model)",
            "ytm-rich-item-renderer:has(ytm-shorts-lockup-view-model)",
            "ytm-video-with-context-renderer:has(ytm-media-item.big-shorts-singleton)",
            "ytm-video-with-context-renderer:has(a.media-item-thumbnail-container[href^=\"/shorts/\"])",
            "ytm-rich-item-renderer:has(a.media-item-thumbnail-container[href^=\"/shorts/\"])",
            "ytm-shorts-lockup-view-model"
          ]
        },
        {
          "id": "yt-search",
          "label": "Shorts shelf + results in Search",
          "tier": "free",
          "requiredCapability": "surface.youtube.shorts",
          "action": "remove",
          "enabledByDefault": true,
          "selectors": [
            "ytd-reel-shelf-renderer",
            "grid-shelf-view-model:has(ytm-shorts-lockup-view-model)",
            "ytd-video-renderer:has(a#thumbnail[href^=\"/shorts/\"])",
            "ytm-video-with-context-renderer:has(ytm-media-item.big-shorts-singleton)",
            "ytm-video-with-context-renderer:has(a.media-item-thumbnail-container[href^=\"/shorts/\"])",
            "ytm-rich-item-renderer:has(a.media-item-thumbnail-container[href^=\"/shorts/\"])",
            "ytm-shorts-lockup-view-model"
          ]
        },
        {
          "id": "yt-subscriptions",
          "label": "Shorts row in Subscriptions",
          "tier": "free",
          "requiredCapability": "surface.youtube.shorts",
          "action": "remove",
          "enabledByDefault": true,
          "selectors": [
            "grid-shelf-view-model:has(ytm-shorts-lockup-view-model)",
            "ytd-reel-shelf-renderer",
            "ytm-reel-shelf-renderer",
            "ytm-shorts-lockup-view-model"
          ]
        },
        {
          "id": "yt-channel-tab",
          "label": "Shorts tab on channel pages",
          "tier": "free",
          "requiredCapability": "surface.youtube.shorts",
          "action": "hide",
          "enabledByDefault": true,
          "selectors": [
            "yt-tab-shape[tab-title=\"Shorts\"]",
            "tp-yt-paper-tab:has([href$=\"/shorts\"])"
          ]
        },
        {
          "id": "yt-chips",
          "label": "Shorts chip in pivot/chip bars",
          "tier": "free",
          "requiredCapability": "surface.youtube.shorts",
          "action": "hide",
          "enabledByDefault": true,
          "selectors": [
            "yt-chip-cloud-chip-renderer:has([title=\"Shorts\"])",
            "yt-chip-cloud-chip-renderer[data-still-shorts-chip]"
          ]
        }
      ]
    },
    "instagram": {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "surfaces": [
        {
          "id": "ig-reels-url",
          "label": "Direct Reels URL → placeholder",
          "tier": "pro",
          "requiredCapability": "surface.instagram.reels",
          "action": "placeholder",
          "enabledByDefault": true,
          "urlMatch": "^/(?:reels?|[^/]+/reels?)(/|$)"
        },
        {
          "id": "ig-nav",
          "label": "Reels nav (sidebar + bottom tab)",
          "tier": "pro",
          "requiredCapability": "surface.instagram.reels",
          "action": "hide",
          "enabledByDefault": true,
          "selectors": [
            "a[href=\"/reels/\"]",
            "a[href^=\"/reels/\"]:not([href*=\"/reels/audio/\"])",
            "a:has(svg[aria-label=\"Reels\"])",
            "a[aria-label*=\"reels\" i]",
            "[role=\"tablist\"] a[href*=\"/reels\"]"
          ]
        },
        {
          "id": "ig-inline",
          "label": "Reels embedded in Home feed",
          "tier": "pro",
          "requiredCapability": "surface.instagram.reels",
          "action": "remove",
          "enabledByDefault": true,
          "selectors": [
            "article:has(a[href^=\"/reel/\"], a[href^=\"https://www.instagram.com/reel/\"])",
            "article:has(a[href^=\"/reels/\"]:not([href*=\"/reels/audio/\"]), a[href^=\"https://www.instagram.com/reels/\"]:not([href*=\"/reels/audio/\"]))"
          ]
        },
        {
          "id": "ig-explore-search",
          "label": "Reel tiles in Explore + Search",
          "tier": "pro",
          "requiredCapability": "surface.instagram.reels",
          "action": "remove",
          "enabledByDefault": true,
          "selectors": [
            "a[href*=\"/reel/\"]:has(span[aria-label*=\"Clip\"])",
            "a[href*=\"/reel/\"] > div > svg[aria-label=\"Clip\"]",
            "a[href*=\"/reel/\"]:has(svg[aria-label=\"Clip\"])"
          ]
        },
        {
          "id": "ig-suggested",
          "label": "Suggested Reels",
          "tier": "pro",
          "requiredCapability": "surface.instagram.reels",
          "action": "remove",
          "enabledByDefault": true,
          "selectors": [
            "section:has(> a[href^=\"/reel/\"], > a[href^=\"https://www.instagram.com/reel/\"])",
            "section:has(> a[href^=\"/reels/\"]:not([href*=\"/reels/audio/\"]), > a[href^=\"https://www.instagram.com/reels/\"]:not([href*=\"/reels/audio/\"]))"
          ]
        },
        {
          "id": "ig-profile-tab",
          "label": "Reels tab on profile grids",
          "tier": "pro",
          "requiredCapability": "surface.instagram.reels",
          "action": "hide",
          "enabledByDefault": true,
          "selectors": [
            "a[href$=\"/reels/\"]"
          ]
        }
      ]
    },
    "tiktok": {
      "matches": [
        "*://*.tiktok.com/*"
      ],
      "surfaces": [
        {
          "id": "tt-blocksite",
          "label": "All of tiktok.com → placeholder",
          "tier": "pro",
          "requiredCapability": "surface.tiktok.block",
          "action": "blockSite",
          "enabledByDefault": true
        }
      ]
    },
    "facebook": {
      "matches": [
        "*://*.facebook.com/*",
        "*://m.facebook.com/*"
      ],
      "surfaces": [
        {
          "id": "fb-reel-url",
          "label": "Direct Reel URL → placeholder",
          "tier": "pro",
          "requiredCapability": "surface.facebook.reels",
          "action": "placeholder",
          "enabledByDefault": true,
          "urlMatch": "^/(?:reels?|(?!(?:groups|hashtag|events|pages|people|marketplace|gaming|games|live|stories|search|help|business|settings|messages|notifications|bookmarks|friends|saved|ads|photo|policies|legal|careers|login|privacy|public)/)[^/]+/reels)(/|$)"
        },
        {
          "id": "fb-feed",
          "label": "Reels in Home feed",
          "tier": "pro",
          "requiredCapability": "surface.facebook.reels",
          "action": "remove",
          "enabledByDefault": true,
          "selectors": [
            "div[role=\"article\"]:has(a[href*=\"/reel/\"])",
            "div[role=\"article\"]:has(a[href*=\"/reels/\"])",
            "[role=\"feed\"] [role=\"article\"]:has(a[href*=\"/reel/\"], a[href*=\"/reels/\"])"
          ]
        },
        {
          "id": "fb-left-menu",
          "label": "Reels shortcut in left menu",
          "tier": "pro",
          "requiredCapability": "surface.facebook.reels",
          "action": "hide",
          "enabledByDefault": true,
          "selectors": [
            "a[aria-label=\"Reels\"]",
            "a[href*=\"/reels/\"]",
            "li:has(> a[href*=\"/reel/\"], > a[href*=\"/reels/\"])"
          ]
        },
        {
          "id": "fb-page-tabs",
          "label": "Reels tab on Page profiles",
          "tier": "pro",
          "requiredCapability": "surface.facebook.reels",
          "action": "hide",
          "enabledByDefault": true,
          "selectors": [
            "a[role=\"tab\"][href*=\"/reels_tab\"]",
            "[role=\"tablist\"] a[href*=\"/reels_tab\"]"
          ]
        },
        {
          "id": "fb-mobile-tabs",
          "label": "Reels tab contents in mobile tab bar",
          "tier": "pro",
          "requiredCapability": "surface.facebook.reels",
          "action": "hide",
          "enabledByDefault": true,
          "selectors": [
            "[role=\"tab\"][aria-label*=\"reels\" i] > *"
          ]
        },
        {
          "id": "fb-watch",
          "label": "Reels inside Watch",
          "tier": "pro",
          "requiredCapability": "surface.facebook.reels",
          "action": "remove",
          "enabledByDefault": true,
          "selectors": [
            "div:has(> a[href*=\"/reel/\"])",
            "div:has(> a[href*=\"/reels/\"])",
            "[role=\"button\"][aria-label*=\"reel video\" i]"
          ]
        },
        {
          "id": "fb-search-groups",
          "label": "Reels in Search + Groups",
          "tier": "pro",
          "requiredCapability": "surface.facebook.reels",
          "action": "remove",
          "enabledByDefault": true,
          "selectors": [
            "div[role=\"article\"]:has(a[href*=\"/reel/\"])",
            "div[role=\"article\"]:has(a[href*=\"/reels/\"])"
          ]
        },
        {
          "id": "fb-suggested",
          "label": "Suggested + related Reels",
          "tier": "pro",
          "requiredCapability": "surface.facebook.reels",
          "action": "remove",
          "enabledByDefault": true,
          "selectors": [
            "div[role=\"article\"]:has(a[href*=\"/reel/\"])",
            "div[role=\"article\"]:has(a[href*=\"/reels/\"])"
          ]
        }
      ]
    }
  },
  "signature": {
    "kid": "still-dev-1",
    "alg": "ed25519",
    "value": "ea008a78f5d9a4311c34a188aa55a4a551f510adcfd34230164b98f169a9b067611f4d0bd96144059ae8fc5c4e0288f581714e4bf886ef6dc065a35ef8bc540f"
  }
}
