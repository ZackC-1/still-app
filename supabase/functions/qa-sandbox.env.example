# Server-only shared-hosted sandbox inputs; every value is intentionally blank.
# Source preparation does not authorize deployment or provider activation.
# QA paid routes fix the environment to sandbox; no environment selector/fallback.
# Keep populated files outside Git and client bundles. See the dated QA plan.

# Existing shared Auth; independently validated, never a paid-authority fallback.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Existing read-only policy role and subject-owned free settings writer.
# Their routes remain independent of QA paid membership and payment credentials.
PRODUCT_POLICY_READER_DB_URL=
SETTINGS_WRITER_DB_URL=

# Dedicated role must be still_qa_sandbox_writer; no production-writer credentials.
STILL_QA_SANDBOX_ENTITLEMENT_WRITER_DB_URL=

# Matched dedicated sandbox Ed25519 signer and independently verified Apple mapping.
STILL_QA_SANDBOX_ACCESS_PROOF_KEY_ID=
STILL_QA_SANDBOX_ACCESS_PROOF_PRIVATE_KEY_PKCS8_BASE64=
STILL_QA_SANDBOX_ACCESS_PROOF_PUBLIC_KEY_HEX=
STILL_QA_SANDBOX_ACCESS_APPLE_PRODUCTS_JSON=
STILL_QA_SANDBOX_APP_STORE_SERVER_PRIVATE_KEY=
STILL_QA_SANDBOX_APP_STORE_SERVER_KEY_ID=
STILL_QA_SANDBOX_APP_STORE_SERVER_ISSUER_ID=

# Current RevenueCat purchase evidence and exact reviewed app/product/store mapping.
STILL_QA_SANDBOX_REVENUECAT_PROJECT_ID=
STILL_QA_SANDBOX_REVENUECAT_ACCESS_SECRET_API_KEY=
STILL_QA_SANDBOX_ACCESS_PROVIDER_PRODUCTS_JSON=

# Dedicated test-mode managed producer. Version must equal 2026-09-30.endive.
STILL_QA_SANDBOX_STRIPE_SECRET_API_KEY=
STILL_QA_SANDBOX_STRIPE_ACCOUNT_ID=
STILL_QA_SANDBOX_STRIPE_API_VERSION=
STILL_QA_SANDBOX_STRIPE_PRICE_ID=
STILL_QA_SANDBOX_STRIPE_PRODUCT_ID=
STILL_QA_SANDBOX_REVENUECAT_STRIPE_PUBLIC_API_KEY=
STILL_QA_SANDBOX_WEB_RETURN_ORIGIN=
STILL_QA_SANDBOX_WEB_RETURN_PATHS_JSON=

# Independent delivery signer; rotating it does not change checkout fingerprints.
STILL_QA_SANDBOX_STRIPE_WEBHOOK_SECRET=
