{
  "name": "still",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r --if-present build && pnpm --filter @still/ext-chromium build:firefox",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:firefox": "playwright test -c tests/firefox/playwright.config.ts --project=lane",
    "test:firefox:qa": "playwright test -c tests/firefox/playwright.config.ts --project=qa",
    "lint": "eslint .",
    "format": "prettier --write .",
    "visual": "node tests/visual/run.mjs",
    "visual:real": "node tests/visual/real/run.mjs",
    "version:check": "node scripts/release/version.mjs check",
    "version:sync": "node scripts/release/version.mjs sync",
    "package:release": "node scripts/release/package.mjs",
    "test:release": "node --test scripts/release/release.test.mjs scripts/release/chrome-store.test.mjs scripts/release/chrome-workflow.test.mjs apps/apple/scripts/release-env-guard.test.mjs",
    "test:chrome-release": "node --test scripts/release/chrome-store.test.mjs scripts/release/chrome-workflow.test.mjs",
    "visual:store": "node tests/visual/store.mjs",
    "test:qa-backend": "node --test \"tests/qa/backend/*.test.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
