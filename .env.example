# Still — environment template.
#
# Copy to `.env.local` and fill in. NEVER commit a real value — only this template is tracked
# (.gitignore ignores `.env.*` and excepts `.env.example`).
#
# Legend on each key:
#   [loop-ok]      safe to load into the autonomous /loop environment
#   [HUMAN-ONLY]   must NEVER be present in any loop-accessible .env — a separate human deploy step
#   [edge-secret]  set on the deployed function via `supabase secrets set`, not in client bundles
#
# Edge Function secrets are configured with `supabase secrets set --env-file <private-file>`
# (see docs/CONNECTIONS.md),
# not read from this file at runtime; they are listed here so the full secret surface is in one place.

# ── Supabase (client) ──────────────────────────────────────────────────────────
# [loop-ok] Public project URL + anon key. Safe in client bundles; RLS is the real boundary.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Client-bundle build env (Vite import.meta.env) ─────────────────────────────
# [loop-ok] The same public URL + anon key, baked into client bundles at build time. Set per
# package in its gitignored .env: packages/ext-chromium/.env (Chrome/Firefox — the background's
# auth/purchase session spine + OTA rule sets; see its .env.example), packages/ext-safari/.env
# (OTA rule sets) and packages/app-webview/.env (Apple sign-in/sync). Absent → that capability is
# simply absent in the build (fail-safe; never a dev fallback —
# docs/solutions/security-issues/gate-production-trust-by-build-mode.md).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# [loop-ok] Explicit modern settings/sync opt-in for configured builds. Exactly "true" selects
# that path; the backend and Apple native authority must support it. See package examples.
VITE_MODERN_SETTINGS_SYNC_ENABLED=
# [loop-ok] Apple developer-only atomic settings opt-in WITHOUT Supabase configuration. Keep
# blank for store builds; requires the matching native App Group authority in both Apple bundles.
VITE_APPLE_ATOMIC_SETTINGS=
# [loop-ok] Scoped-access verifier configuration for Chromium/Firefox and the Apple webview.
# Public values only: environment and a JSON allowlist of {kid, publicKeyHex, purpose, environment}.
# These are verification keys, NEVER issuer signing keys. Use reviewed release configuration;
# blank keeps default production trust with no access keys. This does not enable purchases.
VITE_ACCESS_ENVIRONMENT=
VITE_ACCESS_PUBLIC_KEYS=
# Deterministic App Review sign-in (plan 2026-07-15-002 R13) — set ONLY when producing the Apple
# app-webview bundle for a store submission; extension builds must never define it. The value (the
# designated review address) is never committed anywhere; it lives in the private submission
# record, the App Review notes, and the paired supabase secret REVIEW_SIGNIN_EMAIL.
VITE_REVIEW_SIGNIN_EMAIL=

# ── Supabase (server / migrations only) ─────────────────────────────────────────
# [HUMAN-ONLY] Full service-role key bypasses RLS — privileged server account operations only.
# Keep out of the loop env and out of any client bundle.
SUPABASE_SERVICE_ROLE_KEY=
# [HUMAN-ONLY] Direct DB connection string for `supabase db push` (pooler endpoint — the
# direct host is IPv6-only/unreachable from local Docker; see project memory).
SUPABASE_DB_URL=

# ── Narrow entitlement-write credential (U11/U14) ───────────────────────────────
# [edge-secret] Connection string for the narrow `still_entitlement_writer` Postgres role — the
# credential used for server-authorized entitlement/access writes and security limits (KTD5).
# Provision its LOGIN/password through the backend release procedure. The migrations define its
# narrow grants; it must never be replaced with service_role power.
ENTITLEMENT_WRITER_DB_URL=
# [edge-secret] Supabase project JWT secret — the reconcile function verifies the user JWT with it
# (HS256) so the subject UUID comes only from a valid token, never the request body. The account/
# entitlement functions additionally enforce iss/aud/role: iss is derived from SUPABASE_URL
# (${SUPABASE_URL}/auth/v1), aud/role must be "authenticated" — defense in depth over signature+exp.
SUPABASE_JWT_SECRET=

# [edge-secret] Narrow canonical settings writer for sync-settings (migration 0015).
SETTINGS_WRITER_DB_URL=
# [edge-secret] Narrow product-policy reader and privileged publishing connection. No client access.
PRODUCT_POLICY_READER_DB_URL=
PRODUCT_POLICY_ADMIN_DB_URL=
# Disposable SQL-rehearsal response marker only. Leave unset for hosted release deployments.
SETTINGS_REHEARSAL_INSTANCE=

# ── RevenueCat (U14 / U19) ──────────────────────────────────────────────────────
# [loop-ok] Public SDK key shipped in the Apple app to configure Purchases.
REVENUECAT_PUBLIC_API_KEY=
# [edge-secret] Secret API key for server-side `GET /subscribers/{app_user_id}` lookups.
REVENUECAT_SECRET_API_KEY=
# [edge-secret] Static bearer token RevenueCat sends in the webhook Authorization header;
# compared constant-time as the webhook's primary gate (KTD5). Never logged.
REVENUECAT_WEBHOOK_TOKEN=
# [edge-secret] Server-selected retained web-checkout URL; never supplied by a request body.
REVENUECAT_WEB_BILLING_CHECKOUT_URL=
# [edge-secret] Scoped-access provider setup (V3). Product mappings are reviewed JSON; presence
# of these inputs does not activate a sales flow or establish provider/deployment readiness.
REVENUECAT_ACCESS_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=
ACCESS_PROVIDER_PRODUCTS_JSON=

# ── Scoped-access issuer / Apple provider (V3, server only) ─────────────────────
# [HUMAN-ONLY, edge-secret] Issuer configuration. Signing material NEVER goes in VITE_* values.
# Keep sandbox and production proof/provider configuration separate; follow the V3 release gates.
ACCESS_PROOF_ENVIRONMENT=
ACCESS_PROOF_KEY_ID=
ACCESS_PROOF_PRIVATE_KEY_PKCS8_BASE64=
ACCESS_PROOF_PUBLIC_KEY_HEX=
ACCESS_APPLE_PRODUCTS_JSON=
APP_STORE_SERVER_ISSUER_ID=
APP_STORE_SERVER_KEY_ID=
APP_STORE_SERVER_PRIVATE_KEY=

# ── Rule-set signing (U5 / U12) ─────────────────────────────────────────────────
# [HUMAN-ONLY] Ed25519 PRIVATE signing key for published rule sets. NEVER loaded into the
# loop env — signing is a separate human-only deploy step (U2). Tests use a deterministic
# throwaway test keypair generated in-test, never this key.
RULE_SET_SIGNING_PRIVATE_KEY=
# [loop-ok] Key id (kid) of the current signing key, embedded so clients pick the right pubkey.
RULE_SET_SIGNING_KID=

# ── Email code delivery (U13 / KTD9) ───────────────────────────────────────────
# [HUMAN-ONLY + DNS] Resend API key + verified sender domain for hosted sign-in email delivery.
# Verify live provider configuration/capacity through the auth release procedure.
RESEND_API_KEY=
RESEND_SENDER_DOMAIN=
# [edge-secret] Review-only allowlist address and fixed code. Real values stay in private review
# configuration; the matching Apple bundle input above never belongs in browser extensions.
REVIEW_SIGNIN_EMAIL=
REVIEW_SIGNIN_CODE=

# ── Selector canary notify (U21) ────────────────────────────────────────────────
# [edge-secret] Outbound webhook/email URL the canary posts to when a surface breaks or is
# unverifiable for too long. If unset, the canary logs and no-ops without crashing.
SELECTOR_CANARY_NOTIFY_URL=
# [edge-secret] Static token the scheduler must send in the Authorization header to invoke the
# canary (constant-time compare, fail closed when unset — the schedule alone is not an access
# boundary). Any long random string; shared only with the pg_cron / dashboard schedule.
SELECTOR_CANARY_INVOCATION_TOKEN=

# ── Observability (optional) ────────────────────────────────────────────────────
# [loop-ok] Reserved Sentry DSN. No Sentry integration is enabled merely by setting this value.
SENTRY_DSN=

# Product analytics (ADR 0004). The project key is public by design (it can only send events).
# Blank → no analytics and no "Share usage data" switch.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# [edge-secret] Server-side PostHog identification/erasure configuration (ADR 0004). The personal
# key is privileged and must NEVER be bundled; project/host values are supplied per deployment.
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=
POSTHOG_API_HOST=
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
# [edge-secret] Per-device analytics identity/erasure dependencies. The independent switch must
# be exactly "true" to enable the newer path; blank preserves the released-client behavior.
# The eraser or entitlement-writer connection also supplies analytics-identify's abuse limiter.
ANALYTICS_SUBJECTS_ENABLED=
ANALYTICS_ERASER_DB_URL=
ANALYTICS_ERASURE_WORKER_TOKEN=
ANALYTICS_EVENT_ID_SECRET=
