        "selector": "JSXOpeningElement[name.name='ProOffer'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|pending|failed|success)$/]",
        "message": "<ProOffer> state must be one of 'idle' | 'pending' | 'failed' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RestoreStatus'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|onAction|announce|key|ref|className|style|children)$/]",
        "message": "<RestoreStatus> doesn't accept that prop. Declared props: state, onAction, announce."
      },
      {
        "selector": "JSXOpeningElement[name.name='RestoreStatus'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:checking|restored|nothing|failed|verify)$/]",
        "message": "<RestoreStatus> state must be one of 'checking' | 'restored' | 'nothing' | 'failed' | 'verify'."
