        "selector": "JSXOpeningElement[name.name='SiteSection'] > JSXAttribute[name.name='service'] > Literal[value!=/^(?:youtube|instagram|facebook|tiktok)$/]",
        "message": "<SiteSection> service must be one of 'youtube' | 'instagram' | 'facebook' | 'tiktok'."
      },
