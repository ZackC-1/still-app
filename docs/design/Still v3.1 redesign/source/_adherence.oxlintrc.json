{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/access/**",
              "components/blocked/**",
              "components/brand/**",
              "components/controls/**",
              "components/engagement/**",
              "components/feedback/**",
              "components/layout/**",
              "components/privacy/**",
              "components/sites/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:InterVariable))/i]",
        "message": "Font not provided by the design system. Available: InterVariable."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccessTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|label|boxed|key|ref|className|style|children)$/]",
        "message": "<AccessTag> doesn't accept that prop. Declared props: state, label, boxed."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccessTag'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:free|protected|purchased|checking|verify|locked|unsupported)$/]",
        "message": "<AccessTag> state must be one of 'free' | 'protected' | 'purchased' | 'checking' | 'verify' | 'locked' | 'unsupported'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccountLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|email|onConfirm|onChooseOther|onRetry|signOutNote|key|ref|className|style|children)$/]",
        "message": "<AccountLink> doesn't accept that prop. Declared props: state, email, onConfirm, onChooseOther, onRetry, signOutNote."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccountLink'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:confirm|pending|linked|failed)$/]",
        "message": "<AccountLink> state must be one of 'confirm' | 'pending' | 'linked' | 'failed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:density|host|width|style|children|key|ref|className|style|children)$/]",
        "message": "<AppShell> doesn't accept that prop. Declared props: density, host, width, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute[name.name='density'] > Literal[value!=/^(?:comfortable|compact)$/]",
        "message": "<AppShell> density must be one of 'comfortable' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute[name.name='host'] > Literal[value!=/^(?:browser|safari|apple)$/]",
        "message": "<AppShell> host must be one of 'browser' | 'safari' | 'apple'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|block|inline|center|href|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, block, inline, center, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|link|danger-link|danger-solid)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'link' | 'danger-link' | 'danger-solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConsentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|purposes|never|shareLabel|declineLabel|onShare|onDecline|footnote|key|ref|className|style|children)$/]",
        "message": "<ConsentCard> doesn't accept that prop. Declared props: title, body, purposes, never, shareLabel, declineLabel, onShare, onDecline, footnote."
      },
      {
        "selector": "JSXOpeningElement[name.name='DemoMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<DemoMark> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|body|confirmLabel|onConfirm|cancelLabel|onCancel|tone|contained|trapFocus|children|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, body, confirmLabel, onConfirm, cancelLabel, onCancel, tone, contained, trapFocus, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|danger)$/]",
        "message": "<Dialog> tone must be one of 'default' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Glyph'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|className|title|key|ref|className|style|children)$/]",
        "message": "<Glyph> doesn't accept that prop. Declared props: name, size, className, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Glyph'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:lock|chevron|check|alert|clock|spinner|external)$/]",
        "message": "<Glyph> name must be one of 'lock' | 'chevron' | 'check' | 'alert' | 'clock' | 'spinner' | 'external'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:on|onChange|compact|title|body|key|ref|className|style|children)$/]",
        "message": "<HeroCard> doesn't accept that prop. Declared props: on, onChange, compact, title, body."
      },
      {
        "selector": "JSXOpeningElement[name.name='Invitation'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|store|title|body|actionLabel|onAccept|onDismiss|dismissLabel|key|ref|className|style|children)$/]",
        "message": "<Invitation> doesn't accept that prop. Declared props: kind, store, title, body, actionLabel, onAccept, onDismiss, dismissLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='Invitation'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:sync|link|rating)$/]",
        "message": "<Invitation> kind must be one of 'sync' | 'link' | 'rating'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:markOnly|size|compact|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: markOnly, size, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='OpenSettingsButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:setupTitle|onClick|children|key|ref|className|style|children)$/]",
        "message": "<OpenSettingsButton> doesn't accept that prop. Declared props: setupTitle, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='OwnerAllowances'] > JSXAttribute > JSXIdentifier[name!=/^(?:surfaces|current|draft|onDraftChange|state|onApply|onDiscard|onStatusAction|announce|key|ref|className|style|children)$/]",
        "message": "<OwnerAllowances> doesn't accept that prop. Declared props: surfaces, current, draft, onDraftChange, state, onApply, onDiscard, onStatusAction, announce."
      },
      {
        "selector": "JSXOpeningElement[name.name='OwnerAllowances'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|applying|readback|applied|stale|failed)$/]",
        "message": "<OwnerAllowances> state must be one of 'idle' | 'applying' | 'readback' | 'applied' | 'stale' | 'failed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProOffer'] > JSXAttribute > JSXIdentifier[name!=/^(?:host|offer|channel|signedIn|ownership|state|controls|showList|showPrice|onBuy|onSignIn|onRestore|onOpenHost|onRetry|key|ref|className|style|children)$/]",
        "message": "<ProOffer> doesn't accept that prop. Declared props: host, offer, channel, signedIn, ownership, state, controls, showList, showPrice, onBuy, onSignIn, onRestore, onOpenHost, onRetry."
      },
